{
  "name": "open-quran-view",
  "version": "0.2.1",
  "description": "Universal, cross-platform Quran component library for high-fidelity Mushaf rendering.",
  "type": "module",
  "main": "./dist/view/react/index.js",
  "exports": {
    "./view": {
      "types": "./dist/view/react/index.d.ts",
      "import": "./dist/view/react/index.js"
    },
    "./view/react": {
      "types": "./dist/view/react/index.d.ts",
      "import": "./dist/view/react/index.js"
    },
    "./view/web": {
      "types": "./dist/view/web/index.d.ts",
      "import": "./dist/view/web/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "docs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/**",
    "test": "vitest",
    "generate:all": "tsx scripts/generate-all.ts",
    "generate:pages": "tsx scripts/fetch-pages.ts",
    "generate:metadata": "tsx scripts/fetch-metadata.ts",
    "generate:fonts": "tsx scripts/download-fonts.ts",
    "generate:static:fonts": "tsx scripts/generate-static-fonts.ts",
    "generate:static:data": "tsx scripts/generate-static-data.ts",
    "generate:static": "npm run generate:static:fonts && npm run generate:static:data",
    "playground:install": "pnpm install",
    "playground:build": "pnpm build",
    "playground:setup": "pnpm playground:install && pnpm playground:build",
    "playground:react": "pnpm --filter vite-react dev",
    "playground:web": "pnpm --filter vite-typescript dev",
    "publish": "npm publish"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@quranjs/api": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cheerio": "^1.0.0",
    "@types/node": "^24.10.9",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18",
    "whatwg-fetch": "^3.6.20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelpro/open-quran-view.git"
  },
  "bugs": {
    "url": "https://github.com/adelpro/open-quran-view/issues"
  },
  "homepage": "https://github.com/adelpro/open-quran-view#readme",
  "keywords": [
    "quran",
    "mushaf",
    "react",
    "typescript",
    "quran-component",
    "islamic",
    "arabic",
    "font-rendering",
    "web-component",
    "cross-platform"
  ],
  "author": "adelpro <adelpro@github.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.31.0+sha512.e3927388bfaa8078ceb79b748ffc1e8274e84d75163e67bc22e06c0d3aed43dd153151cbf11d7f8301ff4acb98c68bdc5cadf6989532801ffafe3b3e4a63c268"
}
