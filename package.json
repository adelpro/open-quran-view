{
  "name": "open-quran-view",
  "version": "0.6.1",
  "description": "Universal, cross-platform Quran component library for high-fidelity Mushaf rendering.",
  "type": "module",
  "main": "./dist/view/react/index.js",
  "exports": {
    "./view": {
      "types": "./dist/view/react/index.d.ts",
      "import": "./dist/view/react/index.js"
    },
    "./view/react": {
      "types": "./dist/view/react/index.d.ts",
      "import": "./dist/view/react/index.js"
    },
    "./view/web": {
      "types": "./dist/view/web/index.d.ts",
      "import": "./dist/view/web/index.js"
    },
    "./view/rn": {
      "react-native": "./dist/view/rn/index.js",
      "types": "./dist/view/rn/index.d.ts",
      "default": "./dist/view/rn/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "docs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/**",
    "test": "vitest",
    "generate:all": "tsx scripts/generate-all.ts",
    "generate:pages": "tsx scripts/fetch-pages.ts",
    "generate:metadata": "tsx scripts/fetch-metadata.ts",
    "generate:fonts": "tsx scripts/download-fonts.ts",
    "generate:static:fonts": "tsx scripts/generate-static-fonts.ts",
    "generate:static:data": "tsx scripts/generate-static-data.ts",
    "generate:static": "yarn generate:static:fonts && yarn generate:static:data",
    "generate:glyph-paths": "tsx scripts/extract-glyph-paths.ts",
    "playground:install": "yarn install",
    "playground:build": "yarn build",
    "playground:setup": "yarn playground:install && yarn playground:build",
    "playground:react": "yarn workspace vite-react dev",
    "playground:web": "yarn workspace vite-typescript dev",
    "publish": "npm publish"
  },
  "workspaces": [
    "playground/*",
    "."
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@quranjs/api": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cheerio": "^1.0.0",
    "@types/node": "^24.10.9",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "opentype.js": "^1.3.4",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18",
    "whatwg-fetch": "^3.6.20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adelpro/open-quran-view.git"
  },
  "bugs": {
    "url": "https://github.com/adelpro/open-quran-view/issues"
  },
  "homepage": "https://github.com/adelpro/open-quran-view#readme",
  "keywords": [
    "quran",
    "mushaf",
    "react",
    "typescript",
    "quran-component",
    "islamic",
    "arabic",
    "font-rendering",
    "web-component",
    "cross-platform"
  ],
  "author": "adelpro <adelpro@github.com>",
  "license": "MIT",
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}
