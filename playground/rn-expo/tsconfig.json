{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "open-quran-view": ["../../index.ts"],
      "open-quran-view/*": ["../../*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}